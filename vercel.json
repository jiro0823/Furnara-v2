{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{api/**/*.php,pages/**/*.php,components/**/*.php,includes/**/*.php,assets/**,pictures/**,logo/**,uploads/**}"
    }
  },
  "routes": [
    {
      "src": "^/(?!api/index\\.php$)(.+\\.php)$",
      "dest": "/api/index.php?__route=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php?__route=/"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php?__route=/$1"
    }
  ]
}
